{
  "name": "s6-cut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config web/vite.config.ts --configLoader runner",
    "dev:engine": "python -m uvicorn engine.app:app --host 127.0.0.1 --port 8001 --reload",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts --configLoader runner",
    "lint": "eslint web/src web/vite.config.ts web/vitest.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run --config web/vitest.config.ts",
    "test:engine": "node scripts/test-engine.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:engine && npm run build",
    "check:supported": "node scripts/check-supported.mjs",
    "test:acceptance": "playwright test --config playwright.config.ts",
    "test:e2e:openrouter-fallback": "node scripts/qa/openrouter-fallback.mjs",
    "qa:help-screenshots": "node scripts/qa/generate-help-screenshots.mjs"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "29.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
