# Published web/portal port. This is the URL you open in a browser and
# the only port reachable from your network.
S6_PORT=8080
# Host interface for the published web port (default exposes it on all interfaces).
# Set to 127.0.0.1 for local-only access. Installers also accept the legacy
# S6_PORT=127.0.0.1:8080 form and split it for Compose.
S6_HOST_IP=0.0.0.0

# Engine API port, bound to the host loopback only (API docs and debugging).
# Not reachable from your network. Change only if 8001 is already in use.
S6_ENGINE_PORT=8001

# Use an absolute host/NAS path in production, e.g. /mnt/tank/apps/s6-cut/data
S6_DATA_PATH=./data

S6_WHISPER_MODEL=base
S6_WHISPER_DEVICE=cpu
S6_WHISPER_COMPUTE_TYPE=int8
S6_WHISPER_BEAM_SIZE=1
S6_WHISPER_WORD_TIMESTAMPS=true
S6_JOB_WORKERS=1
S6_MAX_QUEUED_JOBS=4
S6_MAX_UPLOAD_BYTES=20000000000
S6_MAX_SOURCE_SECONDS=14400
S6_JOB_RETENTION_DAYS=30
S6_MAX_RETAINED_JOBS=100
S6_MEDIA_URL_TTL_SECONDS=900
# YouTube connection/setup timeout; active downloads are not cut off by this value.
S6_YTDLP_CONNECT_TIMEOUT=45
S6_YTDLP_SETUP_TIMEOUT=300
# No-byte inactivity period before the import is marked stalled and fails safely.
S6_YTDLP_INACTIVITY_TIMEOUT=300

# Minimum gap kept between neutral fast-cut windows (seconds).
S6_FAST_GUARD_SECONDS=1

# Optional headless provider secrets. The Settings UI can instead store profiles
# encrypted with the local instance key under S6_DATA_PATH/secrets.
OPENROUTER_API_KEY=
