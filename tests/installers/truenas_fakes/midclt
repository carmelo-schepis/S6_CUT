#!/usr/bin/env python3
"""Fake `midclt` for the TrueNAS installer tests: a thin CLI over fake_middleware.

Every call is appended to FAKE_TN_LOG as {"tool": "midclt", "args": [...]}.

FAKE_TN_ARGV_LIMIT (default 1024; 0 disables) reproduces the TrueNAS 25.04 kill:
`sudo` stopped `midclt call -j app.create <compose payload>` once the payload
made argv too long. It printed `sudo: argv[N] mismatch, expected "..."` and the
call died with exit 137.
"""
import json
import os
import sys

import fake_middleware

with open(os.environ["FAKE_TN_LOG"], "a") as log:
    log.write(json.dumps({"tool": "midclt", "args": sys.argv[1:]}) + "\n")

limit = int(os.environ.get("FAKE_TN_ARGV_LIMIT", "1024"))
if limit:
    for n, arg in enumerate(sys.argv):
        if len(arg.encode()) > limit:
            print(f'sudo: argv[{n}] mismatch, expected "{arg[:60]}..."', file=sys.stderr)
            sys.exit(137)


def arg(value):
    # midclt parses each parameter as JSON and falls back to the raw string.
    try:
        return json.loads(value)
    except ValueError:
        return value


args = sys.argv[1:]
assert args[0] == "call", args
args = args[1:]
job = False
if args and args[0] == "-j":
    job = True
    args = args[1:]
method, params = args[0], [arg(a) for a in args[1:]]
try:
    result = fake_middleware.call(method, params, job)
except fake_middleware.MiddlewareError as e:
    print(e, file=sys.stderr)
    sys.exit(1)
print(json.dumps(result))
