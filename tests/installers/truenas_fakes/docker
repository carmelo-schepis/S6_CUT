#!/usr/bin/env python3
"""Fake docker CLI for the TrueNAS installer tests.

`docker compose ... config` runs the real Docker Compose (FAKE_TN_REAL_DOCKER)
so the rendered app YAML is the genuine resolution of compose.yaml + .env.
Everything else is logged and answered from the fake middleware state.
"""
import json
import os
import pathlib
import subprocess
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_TN_LOG"], "a") as log:
    log.write(json.dumps({"tool": "docker", "args": args}) + "\n")
state = json.loads(pathlib.Path(os.environ["FAKE_TN_STATE"]).read_text())

if args[:1] == ["info"]:
    sys.exit(0)
if args[:2] == ["compose", "version"]:
    print("Docker Compose version v2.35.1")
    sys.exit(0)
if args[:1] == ["compose"] and "config" in args:
    sys.exit(subprocess.run([os.environ["FAKE_TN_REAL_DOCKER"], *args]).returncode)
if args[:1] == ["compose"] and ("build" in args or "pull" in args):
    print(f"fake compose {' '.join(args[1:])}")
    sys.exit(0)
if args[:1] == ["compose"]:
    sys.exit(0)
if args[:2] == ["ps", "-a"]:
    project = next(a.rsplit("=", 1)[1] for a in args if a.startswith("label=com.docker.compose.project="))
    app = state["apps"].get(project.removeprefix("ix-"))
    if app and app["state"] == "RUNNING":
        print(os.environ.get("FAKE_TN_WEB_STATUS", "Up 2 minutes (healthy)"))
    sys.exit(0)
print(f"fake docker: unhandled {args}", file=sys.stderr)
sys.exit(1)
